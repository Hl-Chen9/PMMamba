# RADDet-only public upload whitelist.
# Everything is ignored by default; only the files unignored below are staged by `git add .`.
/*

!.gitignore
!README.md
!requirements.txt

!run_finetune_mamba.sh
!benchmark_mamba_raddet.py
!main_finetune_mamba.py
!engine_finetune.py
!utils.py
!selective_scan_interface.py

!datasets/
/datasets/*
!datasets/RADDet.py
!datasets/RADDet_config.json

!models/
/models/*
!models/__init__.py
!models/mamba_raddet.py
!models/RADDet_finetune/
!models/RADDet_finetune/**

# Keep generated and duplicate files out even under whitelisted directories.
__pycache__/
*.py[cod]
*.log
*.npy
*.npz
*.mat
*.h5
*.pkl
*.pickle
*.pt
*.pth
*.ckpt
*.bin
*.onnx
*.tar
*.tar.gz
*.zip
*.ipynb
* copy*.py
*_backup.py
*backup*.py
*backup*.json
models/RADDet_finetune/* copy*.py
models/RADDet_finetune/*backup*
models/RADDet_finetune/__pycache__/
models/RADDet_finetune/RADDet_finetune_dataset_cart.py
models/RADDet_finetune/anchors_cartboxes.txt
models/RADDet_finetune/config_cart.json
models/RADDet_finetune/drawer.py
models/RADDet_finetune/radar_dataset_plot.py

